# .env.example — Espil Online API keys (한곳에 모음)
# 사용법: 이 파일을 .env 로 복사한 뒤, 각 값을 본인 키로 교체하세요.
# .env 는 .gitignore 에 등록돼 있어서 git pull 에 절대 쓸리지 않습니다.
# 키가 비어 있거나 플레이스홀더면 해당 기능만 비활성화되고, 나머지는 정상 동작합니다.

# Google Places API (New) — 건물 이름/상점 정보 (index.html)
GOOGLE_PLACES_KEY=__PUT_YOUR_KEY_HERE__

# Mapbox GL JS 토큰 — vancouver.html / Cauldron 미니맵용
# (현재 index.html 미니맵은 Leaflet + OSM 이라 키가 필요 없습니다)
MAPBOX_TOKEN=__PUT_YOUR_MAPBOX_TOKEN_HERE__

# OpenWeather — Cauldron 날씨용 (build_inject_tokens.py 가 주입)
OPENWEATHER_KEY=__PUT_YOUR_OPENWEATHER_KEY_HERE__

# Meshy API — 3D 에셋 생성 도구용 (tools/generateBaseSet.js, tools/massProducer.js 가 환경변수에서 읽음)
MESHY_API_KEY=__PUT_YOUR_MESHY_API_KEY_HERE__

# 발급 예정 — 아직 없음 (TomTom 실시간 교통 / TransLink 버스)
# TOMTOM_API_KEY=
# TRANSLINK_API_KEY=
